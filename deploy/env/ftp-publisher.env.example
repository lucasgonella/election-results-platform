# Separate operational configuration. Never copy passwords into this file.
# Keep both approvals false until every production gate passes.
ELECTION_FTP_CUTOVER_APPROVED=false
LOCAWEB_FTP_ISOLATION_APPROVED=false
ELECTION_FTP_CREDENTIAL_FILE=/etc/election-results-platform/secrets/ftp.env
LOCAWEB_FTP_PORT=21
# Proposed namespace: NOT provisioned or isolation-approved at audit time.
LOCAWEB_FTP_ELECTION_INBOX_DIR=ftp-inbox/elections/production
ELECTION_FTP_CONTROL_URL=https://afgnet.com.br/api/election-ftp-control.php
ELECTION_HMAC_KEY_FILE=/etc/election-results-platform/secrets/hmac.key
LIVE_PUBLISH_STATE_DIR=/var/lib/election-results-platform/live
