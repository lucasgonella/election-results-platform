# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eleicoes26
POSTGRES_USER=eleicoes26
POSTGRES_PASSWORD=change_me

# TSE runtime
TSE_BASE_URL=https://resultados-sim.tse.jus.br/simulado
TSE_ENVIRONMENT=simulado2026
TSE_CYCLE=ele2026
TSE_ROUND=1

# Collector execution
COLLECTOR_BATCH_SIZE=10
COLLECTOR_WORKERS=1
COLLECTOR_CYCLES=1

# Explicit safety gate.
# Keep false for the simulator.
# Production requires an intentional change.
COLLECTOR_ALLOW_OFFICIAL=false

# Static results publishing
PUBLISH_AFTER_COLLECT=false
PUBLISH_PENDING_FILE=/var/lib/election-results-platform/runtime/publish.pending
PUBLISH_EXPECTED_TARGETS=137
PUBLISH_REMOTE_HOST=ftp.example.com
PUBLISH_REMOTE_USER=change_me
PUBLISH_REMOTE_DIR=/path/to/public_html/data
PUBLISH_SSH_KEY=/var/lib/election-results-platform/.ssh/locaweb_publisher
PUBLISH_KNOWN_HOSTS=/var/lib/election-results-platform/.ssh/known_hosts

# Low-latency live publisher
# When this owns /data, keep PUBLISH_AFTER_COLLECT=false
# so the DB publisher cannot overwrite fresher live files.
LIVE_PUBLISH_STATE_DIR=/var/lib/election-results-platform/live
LIVE_PUBLISH_WORKERS=16
LIVE_PUBLISH_EXPECTED_TARGETS=137